# Supabase project settings (server-only; never prefix service keys with VITE_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_MEDIA_BUCKET=product-media

# The admin login password must exactly match PRODUCT_ADMIN_API_TOKEN.
# Replace the repository's demo password (1240928) before production.
PRODUCT_ADMIN_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN

# Separate long random bearer token for Manus AI agent product management.
MANUS_AGENT_API_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_AGENT_TOKEN
